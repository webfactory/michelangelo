        /* Lemon Sans Next Regular 300 */
        @font-face {
            font-family: 'Lemon';
            font-style: normal;
            font-weight: 300;
            src:
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-Regular.woff2') format('woff2'), /* Chrome 26+, Opera 23+, Firefox 39+ */
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-Regular.woff') format('woff'); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        }
        /* Lemon Sans Next Regular 400 */
        @font-face {
            font-family: 'Lemon';
            font-style: normal;
            font-weight: 400;
            src:
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-Regular.woff2') format('woff2'), /* Chrome 26+, Opera 23+, Firefox 39+ */
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-Regular.woff') format('woff'); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        }
        /* Lemon Sans Next Regular Italic 300 */
        @font-face {
            font-family: 'Lemon';
            font-style: italic;
            font-weight: 400;
            src:
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-RegularItalic.woff2') format('woff2'), /* Chrome 26+, Opera 23+, Firefox 39+ */
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-RegularItalic.woff') format('woff'); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        }
        /* Hinweis: als fetten Schnitt verwenden wir die Lemon Medium! */
        /* Lemon Sans Next Medium 700 */
        @font-face {
            font-family: 'Lemon';
            font-style: normal;
            font-weight: 700;
            src:
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-Medium.woff2') format('woff2'), /* Chrome 26+, Opera 23+, Firefox 39+ */
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-Medium.woff') format('woff'); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        }
        /* Lemon Sans Next Medium Italic 700 */
        @font-face {
            font-family: 'Lemon';
            font-style: italic;
            font-weight: 700;
            src:
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-MediumItalic.woff2') format('woff2'), /* Chrome 26+, Opera 23+, Firefox 39+ */
                url('/bundles/gbadesignsystem/fonts/LemonSansNext-MediumItalic.woff') format('woff'); /* Chrome 6+, Firefox 3.6+, IE 9+, Safari 5.1+ */
        }
    </style>

